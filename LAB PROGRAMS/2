def solve_queens(board, row):
    if row == 8:
        for r in board:
            print(" ".join("Q" if c == r else "." for c in range(8)))
        return True

    for col in range(8):
        safe = True

        for i in range(row):
            if board[i] == col or abs(board[i] - col) == abs(i - row):
                safe = False
                break

        if safe:
            board[row] = col
            if solve_queens(board, row + 1):
                return True

    return False

board = [-1] * 8
solve_queens(board, 0)
