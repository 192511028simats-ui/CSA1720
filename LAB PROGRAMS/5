from collections import deque

def solve():
    start = (3, 3, 1)
    goal = (0, 0, 0)

    q = deque([(start, [])])
    visited = set()

    moves = [(1, 0), (2, 0), (0, 1), (0, 2), (1, 1)]

    while q:
        state, path = q.popleft()
        m, c, boat = state

        if state == goal:
            for s in path + [state]:
                print(s)
            return

        if state in visited:
            continue
        visited.add(state)

        for a, b in moves:
            if boat == 1:
                nm, nc = m - a, c - b
                nb = 0
            else:
                nm, nc = m + a, c + b
                nb = 1

            if 0 <= nm <= 3 and 0 <= nc <= 3:
                rm, rc = 3 - nm, 3 - nc

                if (nm == 0 or nm >= nc) and (rm == 0 or rm >= rc):
                    new_state = (nm, nc, nb)
                    if new_state not in visited:
                        q.append((new_state, path + [state]))

    print("No solution found")

solve()
