def vacuum_cleaner():
    rooms = {'A': 1, 'B': 1}
    location = 'A'

    while 1 in rooms.values():
        if rooms[location] == 1:
            print("Room", location, "is dirty. Cleaning...")
            rooms[location] = 0
        else:
            print("Room", location, "is clean.")

        location = 'B' if location == 'A' else 'A'

    print("All rooms are clean!")

vacuum_cleaner()
